# Copia este archivo como .env y completa los valores. Solo para desarrollo (T22).
# La carpeta de contenido elegida en la app (asistente o Ajustes) vive en su config.json
# — ~/.config/sala/config.json en Linux, %LOCALAPPDATA%\sala en Windows — y tiene prioridad
# sobre este archivo. CONTENT_DIR aquí es opcional: úsalo como override de desarrollo.
TMDB_READ_ACCESS_TOKEN=
PORT=8080
CONTENT_DIR=./content
DATA_DIR=./data

# Procesamiento (opcionales). T21: el presupuesto se deriva del hardware (CPU × PROCESS_CPU_SHARE,
# RAM disponible, tipo de disco). `auto` = derivado; un número lo fija.
PROCESS_CONCURRENCY=auto
FFMPEG_THREADS=auto
PROCESS_CPU_SHARE=0.5
# Tope de jobs en paralelo. Provisional 1 (como hasta ahora); 4 es lo recomendado tras el benchmark T21d.
PROCESS_MAX_JOBS=1
# Medido en el portatil del dueno (16 hilos, T21d 2026-10-11): PROCESS_MAX_JOBS=2 + FFMPEG_THREADS=8
# dio +30% de throughput con p95 +0.8 ms. Sube PROCESS_MAX_JOBS si tu maquina lo soporta.
PROCESS_RAM_PER_JOB_MB=1200
PROCESS_RAM_RESERVE_MB=1536
# auto | ssd | hdd. `auto` trata un volumen rotacional o de tipo desconocido como 1 job.
PROCESS_IO=auto
# nice del ffmpeg (-20..19); 19 mantiene fluida la reproducción.
PROCESS_NICE=19

# Caché de paquetes copy (T47c). Los videos H.264 8 bits se empaquetan al primer play (~4 s) y esos
# paquetes son regenerables: sobre este presupuesto se expulsan los menos reproducidos (nunca x264 ni originales).
CACHE_BUDGET_GB=20
# Protección de espacio: el procesado se pausa (aviso en Actividad) si tras escribir quedaría menos que
# el mayor entre MIN_FREE_GB y MIN_FREE_PCT % del volumen del HLS.
MIN_FREE_GB=10
MIN_FREE_PCT=10
