# Copia este archivo como .env y completa los valores. Solo para desarrollo (T22).
# La carpeta de contenido elegida en la app (asistente o Ajustes) vive en su config.json
# — ~/.config/sala/config.json en Linux, %LOCALAPPDATA%\sala en Windows — y tiene prioridad
# sobre este archivo. CONTENT_DIR aquí es opcional: úsalo como override de desarrollo.
TMDB_READ_ACCESS_TOKEN=
PORT=8080
CONTENT_DIR=./content
DATA_DIR=./data

# Procesamiento (opcionales). Hilos de x264 por job y jobs en paralelo.
FFMPEG_THREADS=8
PROCESS_CONCURRENCY=1

# Caché de paquetes copy (T47c). Los videos H.264 8 bits se empaquetan al primer play (~4 s) y esos
# paquetes son regenerables: sobre este presupuesto se expulsan los menos reproducidos (nunca x264 ni originales).
CACHE_BUDGET_GB=20
# Protección de espacio: el procesado se pausa (aviso en Actividad) si tras escribir quedaría menos que
# el mayor entre MIN_FREE_GB y MIN_FREE_PCT % del volumen del HLS.
MIN_FREE_GB=10
MIN_FREE_PCT=10
